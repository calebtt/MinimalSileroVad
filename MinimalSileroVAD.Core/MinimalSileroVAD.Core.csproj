<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<!-- Or <TargetFrameworks>net8.0;net6.0</TargetFrameworks> for multi-target -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- Auto-generates .nupkg on release build -->
		<PackageId>MinimalSileroVAD</PackageId>
		<!-- Unique ID; check nuget.org for conflicts -->
		<Version>2.0.0</Version>
		<!-- Semantic version; update for releases -->
		<Authors>Caleb Taylor</Authors>
		<Description>Cross-platform Voice Activity Detection and speech segmentation using the Silero VAD models via ONNX Runtime, with no WebRTC dependency. Bundles both the Silero V4 and V5 models (V5 supports 8 kHz and 16 kHz) and selects between them through a single configurable VadSpeechSegmenter. Runs on CPU or CUDA, with automatic CPU fallback.</Description>
		<PackageProjectUrl>https://github.com/calebtt/MinimalSileroVAD</PackageProjectUrl>
		<RepositoryUrl>https://github.com/calebtt/MinimalSileroVAD.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>vad; onnx; silero; silero-v5; voice; audio; cross-platform; speech-detection; speech-segmentation; voice-activity-detection</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- XML docs for IntelliSense -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<!-- Matches LICENSE.md -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Displays on nuget.org -->
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>2.0.0 (breaking): Unified V4/V5 behind a single VadSpeechSegmenter(VadOptions) selected by VadOptions.ModelVersion, one IVadSpeechSegmenter interface, and SpeechSegment event payloads. Adds Silero V5 (8 kHz/16 kHz) and per-stream Reset(). Renamed SileroModel to SileroModelV4. Removed VadSpeechSegmenterSileroV4/V5 and the old MemoryStream event API.</PackageReleaseNotes>
	</PropertyGroup>

	<!-- Use the CUDA runtime on Linux + Windows by default; macOS has no CUDA build.
	     Override with -p:UseCudaOnnxRuntime=false for CPU-only/headless environments (e.g. CI),
	     where the GPU native library can't load without CUDA installed. -->
	<PropertyGroup Condition="'$(UseCudaOnnxRuntime)' == ''">
		<UseCudaOnnxRuntime Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $([MSBuild]::IsOSPlatform('Linux'))">true</UseCudaOnnxRuntime>
		<UseCudaOnnxRuntime Condition="'$(UseCudaOnnxRuntime)' == ''">false</UseCudaOnnxRuntime>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.23.1" Condition="'$(UseCudaOnnxRuntime)' == 'true'" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.1" Condition="'$(UseCudaOnnxRuntime)' != 'true'" />
		<!-- Update to latest if tested -->
		<PackageReference Include="Serilog" Version="4.3.0" />
		<!-- Update to latest if tested -->

		<InternalsVisibleTo Include="MinimalSileroVAD.Core.Tests" />

		<!-- Embed Silero models (no file copy needed at runtime) -->
		<EmbeddedResource Include="models\silero_vad.onnx" />
		<EmbeddedResource Include="models\silero_vad_v5.onnx" />

		<!-- Include README for package -->
		<None Include="..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>